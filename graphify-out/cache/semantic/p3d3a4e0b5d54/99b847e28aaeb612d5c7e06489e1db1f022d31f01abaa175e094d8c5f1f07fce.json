l, "author": null, "contributor": null, "rationale": "Four tabs (\ud648, \uc81c\uc5b4, \uc608\uce21\u00b7\uc54c\ub9bc, \uc124\uc815) in a floating rounded bar; the selected tab gets a light-blue background.", "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_forecast_banner", "label": "Forecast Pre-Ventilation Banner", "file_type": "concept", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A partly hidden banner in the CO2 state: '2\uc2dc\uac04 \ub4a4 \uc2e4\uc678 \ubbf8\uc138\uba3c\uc9c0\uac00 \ub098\ube60\uc9c8 \uc608\uc815\uc774\ub77c \uc9c0\uae08\uc774 \ud658\u2026'. This is ML rule 4, which is out of scope, so it should be dummy data or marked as a future extension.", "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_co2_threshold", "label": "CO2 Threshold 1,000ppm", "file_type": "concept", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_pm25_threshold", "label": "PM2.5 Threshold 35\u338d/\u33a5", "file_type": "concept", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}], "edges": [{"source": "docs_slide_app_home_3states_app_home_3states_slide", "target": "docs_slide_app_home_3states_normal_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/slide_app_home_3states.png", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_slide_app_home_3states_app_home_3states_slide", "target": "docs_slide_app_home_3states_co2_high_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/slide_app_home_3states.png", "source_