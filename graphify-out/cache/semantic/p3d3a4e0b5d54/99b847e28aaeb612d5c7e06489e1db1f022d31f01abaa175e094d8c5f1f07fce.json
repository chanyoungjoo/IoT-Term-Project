{"nodes": [{"id": "docs_slide_app_home_3states_app_home_3states_slide", "label": "App Home 3-State Slide", "file_type": "image", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Side-by-side mockups of the mobile app home screen in its three status states, used as a one-glance design reference.", "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_normal_state", "label": "Normal State (Blue Hero)", "file_type": "concept", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CO2 620, outside PM2.5 18. Headline '\uacf5\uae30\uac00 \uae68\ub057\ud574\uc694'; air purifier on power-saving standby (rule 5).", "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_co2_high_state", "label": "CO2 High State (Orange Hero)", "file_type": "concept", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CO2 1,180 over the 1,000ppm limit and outside air is fine, so the app tells people to ventilate ('\ud658\uae30\uac00 \ud544\uc694\ud574\uc694', rule 2).", "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_outdoor_bad_state", "label": "Outdoor Bad State (Navy Hero)", "file_type": "concept", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CO2 1,080 and outside PM2.5 58 (bad), so ventilation is limited: keep windows closed and run the air purifier (rule 3).", "_origin": "semantic"}, {"id": "docs_slide_app_home_3states_status_hero", "label": "Status-Colored Hero", "file_type": "rationale", "source_file": "docs/slide_app_home_3states.png", "source_location": null, "source_url": null, "captured_at": null, "a