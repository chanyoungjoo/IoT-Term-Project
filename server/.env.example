# 이 파일을 복사해서 server/.env 로 만들고 값을 채운다 (cp server/.env.example server/.env)
# server/.env 는 .gitignore 에 들어 있어서 깃에 올라가지 않는다. 키를 절대 커밋하지 말 것.

# Claude Console > API Keys 에서 발급한 키
ANTHROPIC_API_KEY=

# 사용할 모델 (비용 때문에 Haiku)
ANTHROPIC_MODEL=claude-haiku-5-5

# 하루 최대 /api/chat 호출 수 (비용 안전장치, 한국 시간 자정에 초기화)
DAILY_LIMIT=300
